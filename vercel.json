{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },

    { "src": "^/dashboard/?$", "status": 302, "dest": "/dashboard/incidents/" },

    { "src": "^/login$", "status": 302, "dest": "/" },

    { "src": "/.*", "dest": "/index.html" }
  ]
}
